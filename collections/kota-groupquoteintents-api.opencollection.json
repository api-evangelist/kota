{
  "opencollection": "1.0.0",
  "info": {
    "name": "API Reference Associated Persons groupQuoteIntents API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "groupQuoteIntents",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List group quote intents",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://test.api.kota.io/group_quote_intents",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "group_id",
                "value": "",
                "type": "query",
                "description": "Filter by group ID"
              },
              {
                "name": "plan_id",
                "value": "",
                "type": "query",
                "description": "Filter by plan ID"
              },
              {
                "name": "status",
                "value": "",
                "type": "query",
                "description": "Multiple values can be provided by separating them with a comma. Allowed values are: `processing`, `action_required`, `awaiting_quote`, `quote_available`, `rejected`, `rejected_by_insurer`, `quote_expired`."
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "The page of results to return. Defaults to 1 if not provided."
              },
              {
                "name": "page_size",
                "value": "",
                "type": "query",
                "description": "The number of results to return per page. Defaults to 10 if not provided. Maximum value is 100."
              }
            ]
          },
          "docs": "Returns a paginated list of `group_quote_intent`'s. The results are returned sorted by creation date, with the most recent appearing first."
        },
        {
          "info": {
            "name": "Create a group quote intent",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://test.api.kota.io/group_quote_intents",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a `group_quote_intent` to request a quote for a `group` and `plan` combination. The intent coordinates the quote workflow including requirements collection and quote generation."
        },
        {
          "info": {
            "name": "Retrieve a group quote intent",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://test.api.kota.io/group_quote_intents/:group_quote_intent_id",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "group_quote_intent_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieves a `group_quote_intent` object."
        },
        {
          "info": {
            "name": "List requirements for a group quote intent",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://test.api.kota.io/group_quote_intents/:group_quote_intent_id/requirements",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "group_quote_intent_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "object_type",
                "value": "",
                "type": "query",
                "description": "Filter by object type (employee or employer)"
              },
              {
                "name": "object_id",
                "value": "",
                "type": "query",
                "description": "Filter by object ID (employee ID or employer ID)"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "The page of results to return. Defaults to 1 if not provided."
              },
              {
                "name": "page_size",
                "value": "",
                "type": "query",
                "description": "The number of results to return per page. Defaults to 10 if not provided. Maximum value is 100."
              }
            ]
          },
          "docs": "Returns a paginated list of adaptive requirements for a `group_quote_intent`. Requirements must be fulfilled before a quote can be generated."
        },
        {
          "info": {
            "name": "Retrieve the quote for a group quote intent",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://test.api.kota.io/group_quote_intents/:group_quote_intent_id/quote",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "group_quote_intent_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieves the quote details for a `group_quote_intent`. Returns pricing information and a fresh PDF URL. Only available when status is `quote_available`."
        },
        {
          "info": {
            "name": "Reject a group quote intent",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://test.api.kota.io/group_quote_intents/:group_quote_intent_id/reject",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "group_quote_intent_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Rejects a `group_quote_intent` when the employer decides not to proceed with the quote. Can only reject intents in `quote_available` status."
        }
      ]
    }
  ],
  "bundled": true
}