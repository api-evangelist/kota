              }
            ],
            "params": [
              {
                "name": "employee_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "associated_person_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
