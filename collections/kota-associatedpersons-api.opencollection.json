      "items": [
        {
          "info": {
            "name": "List associated persons",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://test.api.kota.io/employees/:employee_id/associated_persons",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "employee_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "The page of results to return. Defaults to 1 if not provided."
              },
              {
                "name": "page_size",
                "value": "",
                "type": "query",
                "description": "The number of results to return per page. Defaults to 10 if not provided. Maximum value is 100."
              }
            ]
          },
          "docs": "Returns a list of all `associated person`'s for a specific `employee`. The `associated person`'s are returned sorted by creation date, with the most recent `associated person` appearing first."
        },
        {
          "info": {
            "name": "Create an associated person",
            "type": "http"
          },
