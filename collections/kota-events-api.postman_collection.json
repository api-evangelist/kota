          "name": "List all events",
          "request": {
            "name": "List all events",
            "description": {
              "content": "Returns a list of `events` sorted by creation date, with the most recently created event appearing first. The event list includes data from up to the last 30 days.\n\nEach `event`’s data is rendered according to the API version at the time of its creation, as specified by the `api_version` attribute in the event object, rather than the current API version.",
              "type": "text/plain"
            },
