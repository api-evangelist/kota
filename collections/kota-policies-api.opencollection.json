{
  "opencollection": "1.0.0",
  "info": {
    "name": "API Reference Associated Persons policies API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "policies",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List all policies",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://test.api.kota.io/policies",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "employee_id",
                "value": "",
                "type": "query",
                "description": "Filters policies by employee."
              },
              {
                "name": "group_id",
                "value": "",
                "type": "query",
                "description": "Filters policies by group."
              },
              {
                "name": "group_policy_id",
                "value": "",
                "type": "query",
                "description": "Filters policies by group policy."
              },
              {
                "name": "status",
                "value": "",
                "type": "query",
                "description": "Multiple values can be provided by separating them with a comma. Allowed values are: `scheduled`, `active`, `expired`, `cancelled`."
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "The page of results to return. Defaults to 1 if not provided."
              },
              {
                "name": "page_size",
                "value": "",
                "type": "query",
                "description": "The number of results to return per page. Defaults to 10 if not provided. Maximum value is 100."
              }
            ]
          },
          "docs": "Returns a list of `policies`. By default, only `active` and `scheduled` policies are returned. Use the `status` query parameter to filter by other statuses. The `policies` are returned sorted by creation date, with the most recent `policy` appearing first."
        },
        {
          "info": {
            "name": "Retrieve a policy",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://test.api.kota.io/policies/:policy_id",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "policy_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieves a `policy` object."
        }
      ]
    }
  ],
  "bundled": true
}