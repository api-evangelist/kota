{
  "opencollection": "1.0.0",
  "info": {
    "name": "API Reference Associated Persons healthInsurance API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "healthInsurance",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve employer quote",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://test.api.kota.io/employers/:employer_id/health_insurance/quotes/:employer_quote_id",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "employer_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "employer_quote_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Returns group's health insurance `quote` for an `employer` by `employer_quote_id`."
        },
        {
          "info": {
            "name": "List all employer quotes",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://test.api.kota.io/employers/:employer_id/health_insurance/quotes",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "employer_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "status",
                "value": "",
                "type": "query",
                "description": "Multiple values can be provided by separating them with a comma. Allowed values are: `pending_quote`, `action_required`, `not_undertaken`, `accepted`, `pending_insurer_acceptance`."
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "The page of results to return. Defaults to 1 if not provided."
              },
              {
                "name": "page_size",
                "value": "",
                "type": "query",
                "description": "The number of results to return per page. Defaults to 10 if not provided. Maximum value is 100."
              }
            ]
          },
          "docs": "Returns a list of health insurance `quotes` for an `employer`. The `quotes` are returned sorted by creation date, with the most recent `quote` appearing first."
        },
