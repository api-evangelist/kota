      "items": [
        {
          "info": {
            "name": "List all webhook endpoints",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://test.api.kota.io/webhooks/endpoints",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "The page of results to return. Defaults to 1 if not provided."
              },
              {
                "name": "page_size",
                "value": "",
                "type": "query",
                "description": "The number of results to return per page. Defaults to 10 if not provided. Maximum value is 100."
              }
            ]
          },
          "docs": "Get all registered webhook endpoints for the platform."
        },
        {
          "info": {
            "name": "Retrieve a webhook endpoint",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://test.api.kota.io/webhooks/endpoints/:webhook_endpoint_id",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "webhook_endpoint_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get a registered webhook endpoint by its Id."
        }
      ]
    }
  ],
