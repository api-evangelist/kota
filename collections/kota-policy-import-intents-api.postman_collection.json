                },
                {
                  "disabled": false,
                  "key": "group_id",
                  "value": "<string>",
                  "description": "Filters policy import intents by group ID. Prefixed with `g_`."
                },
                {
                  "disabled": false,
                  "key": "status",
                  "value": "<string>",
                  "description": "Multiple values can be provided by separating them with a comma. Allowed values are: `processing`, `failed`, `success`."
